// PaddleHub database schema
// Run `npm run db:migrate` after edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

enum MatchFormat {
  SINGLES
  DOUBLES
}

enum MatchStatus {
  OPEN
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum Role {
  PLAYER
  ADMIN
}

enum CourtStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
  RENTED
}

enum EventStatus {
  OPEN          // scheduled, signups open
  IN_PROGRESS   // event is live; late signups still allowed
  COMPLETED
  CANCELLED
}

enum SignupStatus {
  PENDING       // request received; awaiting admin confirmation
  CONFIRMED     // counts toward event capacity
  DECLINED
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String
  avatarUrl     String?
  bio           String?
  role          Role     @default(PLAYER)
  skillRating   Float    @default(3.0)
  skillLevel    SkillLevel @default(INTERMEDIATE)
  preferredFormat MatchFormat @default(DOUBLES)
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hostedMatches Match[]  @relation("MatchHost")
  participants  MatchParticipant[]
  ratingsGiven  Rating[] @relation("RatingFrom")
  ratingsReceived Rating[] @relation("RatingTo")
  notifications Notification[]
  managedCourts Court[]  @relation("CourtManager")
  hostedEvents  Event[]  @relation("EventHost")
  eventSignups  EventSignup[]
  pushSubscriptions PushSubscription[]

  @@index([skillRating])
}

// Web Push API subscription. One row per (user, browser/device) — a user can
// have many (laptop + phone). Pruned on 404/410 from the push service.
// `origin` is the page origin (scheme + host) where the subscription was
// created. It's recorded so we can prune subscriptions from orphan origins
// (e.g. an old dev tunnel URL) when the user re-subscribes from a new one.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  origin    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An Event is a scheduled gathering players sign up for. Matchmaking later
// turns signups into Matches (each Match referencing a Court). The Event itself
// has no direct Court relation — courts are picked per-Match.
model Event {
  id          String      @id @default(cuid())
  name        String
  description String?
  hostId      String
  host        User        @relation("EventHost", fields: [hostId], references: [id])
  scheduledAt DateTime
  endsAt      DateTime?
  format      MatchFormat @default(DOUBLES)
  capacity    Int
  skillMin    Float       @default(1.0)
  skillMax    Float       @default(5.0)
  status      EventStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  signups EventSignup[]
  matches Match[]

  @@index([status, scheduledAt])
}

model EventSignup {
  id          String       @id @default(cuid())
  eventId     String
  userId      String
  status      SignupStatus @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime     @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

model Court {
  id        String      @id @default(cuid())
  name      String      @unique
  location  String
  surface   String
  status    CourtStatus @default(AVAILABLE)
  managerId String
  manager   User        @relation("CourtManager", fields: [managerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  matches   Match[]

  @@index([status])
}

model Match {
  id          String      @id @default(cuid())
  hostId      String
  host        User        @relation("MatchHost", fields: [hostId], references: [id])
  courtId     String?
  court       Court?      @relation(fields: [courtId], references: [id])
  eventId     String?
  event       Event?      @relation(fields: [eventId], references: [id])
  scheduledAt DateTime
  startedAt   DateTime?
  format      MatchFormat
  skillMin    Float       @default(2.0)
  skillMax    Float       @default(5.0)
  capacity    Int
  notes       String?
  status      MatchStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants MatchParticipant[]
  ratings      Rating[]

  @@index([status, scheduledAt])
  @@index([courtId, scheduledAt])
  @@index([eventId])
}

model MatchParticipant {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  joinedAt  DateTime @default(now())
  waitlist  Boolean  @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}

model Rating {
  id        String   @id @default(cuid())
  matchId   String
  fromId    String
  toId      String
  sportsmanship Int  // 1-5
  punctuality   Int  // 1-5
  comment   String?
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  from  User  @relation("RatingFrom", fields: [fromId], references: [id])
  to    User  @relation("RatingTo", fields: [toId], references: [id])

  @@unique([matchId, fromId, toId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}
